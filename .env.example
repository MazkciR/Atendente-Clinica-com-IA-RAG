# Copie este arquivo para ".env" e preencha os valores.
# O arquivo ".env" NUNCA deve ser enviado ao GitHub (ele já está no .gitignore).
# Este arquivo ".env.example" é só um MODELO: não escreva chaves reais aqui.

# "simulado" = resposta de teste, sem internet e sem chave (padrão)
# "api"      = chama o modelo de verdade (exige as duas linhas abaixo)
LLM_MODO=simulado

# Sua chave de API (cada pessoa usa a PRÓPRIA). Deixe vazio enquanto estiver no modo simulado.
LLM_API_KEY=

# Nome do modelo, como aparece na documentação do provedor (exemplo; confira o nome atual).
LLM_MODEL=claude-sonnet-5-5

# Versão do prompt usada por padrão: v1, v2 ou v3
PROMPT_VERSAO=v3

# Opcional: só preencha se a versão do modelo aceitar "temperature" (ex.: 0)
# LLM_TEMPERATURA=
